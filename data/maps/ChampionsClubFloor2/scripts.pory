script ChampionsClubFloor2_EventScript_AlreadyBattled {
    msgbox(ChampionsClubFloor2_Text_AlreadyBattled)
    releaseall
    end
}

text ChampionsClubFloor2_Text_BattleIntro {
    "Let's see what a fellow Champion\ncan do!"
}

text ChampionsClubFloor2_Text_BattleDefeat {
    "A worthy victory."
}

text ChampionsClubFloor2_Text_AlreadyBattled {
    "We've already battled today.\nLet's meet again another day."
}
