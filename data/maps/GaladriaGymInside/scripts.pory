mapscripts GaladriaGymInside_MapScripts {
    MAP_SCRIPT_ON_LOAD: GaladriaGymInside_OnLoad
}

script GaladriaGymInside_OnLoad {
    if (flag(FLAG_GALADRIA_GYM_VENUSAUR_MOVED)) {
        setobjectxyperm(Venesaur, 3, 7)
        setobjectmovementtype(Venesaur, MOVEMENT_TYPE_FACE_RIGHT)
    }
    if (flag(FLAG_GALADRIA_GYM_MEGANIUM_MOVED)) {
        setobjectxyperm(Meganium, 14, 8)
        setobjectmovementtype(Meganium, MOVEMENT_TYPE_FACE_LEFT)
    }
    if (flag(FLAG_GALADRIA_GYM_BRELOOM_MOVED)) {
        setobjectxyperm(Breloom, 17, 4)
        setobjectmovementtype(Breloom, MOVEMENT_TYPE_FACE_LEFT)
    }
}

text LeafIntroText {
    "Welcome challenger!\nI'm Leaf, the Grass-type Gym Leader.\p"
    "Let’s see if you can cut through my vines of victory!"
}

text LeafDefeatText {
    "You've pruned your way to victory...\nWell done, trainer."
}

text LeafMoreText {
    "You're not ready for this."
}


text VenusaurIntro {
    "You don't deserve Leaf.\nMy VENUSAUR will sleep you!.\p"
}

text VenusaurDefeatText {
    "GAH, My spore missed..."
}

text MeganiumIntro {
    "I like sleeping all day.\nLeaf let's me, that's why she's the best!\p"
}

text MeganiumDefeatText {
    "Hmmm, I think I need a nap."
}

text BreloomIntro {
    "I could never beat Leaf though.\nLeaf's the best!\p"
}

text BreloomDefeatText {
    "Ugh, I need to train more."
}

script GymLeaderLeaf {
    lock
    faceplayer
    trainerbattle_double(TRAINER_LEAF, LeafIntroText, LeafDefeatText, Leaf_no_mon, LeafDefeated, NO_MUSIC)
    release
    end
    
}

script LeafDefeated {
    setflag(FLAG_GRASS_GYM)
    msgbox("The Elite 4 awaits...")
    waitmessage
    release
    end
}

script VenusaurTrainer {
    lock
    faceplayer
    goto_if_defeated(TRAINER_RED, VenusaurTrainer_Defeated)
    msgbox("Venesaur is slept on!")
    waitmessage
    trainerbattle_single(TRAINER_RED, VenusaurIntro, VenusaurDefeatText, venesaurDefeat)
    releaseall
    end
}

script VenusaurTrainer_Defeated {
    msgbox("You still won't beat Leaf!")
    waitmessage
    releaseall
    end
}

script venesaurDefeat {
    setflag(FLAG_GALADRIA_GYM_VENUSAUR_MOVED)
    msgbox("You still won't beat Leaf!")
    waitmessage
    applymovement(Venesaur, Galadria_Movement_Ven)
    waitmovement
    releaseall
    end
}

script MeganiumTrainer {
    lock
    faceplayer
    goto_if_defeated(TRAINER_MAY_PLACEHOLDER, MeganiumTrainer_Defeated)
    msgbox("This is my dream.")
    waitmessage
    trainerbattle_single(TRAINER_MAY_PLACEHOLDER, MeganiumIntro, MeganiumDefeatText, meganiumDefeat)
    releaseall
    end
}

script MeganiumTrainer_Defeated {
    msgbox("I dream a lot...")
    waitmessage
    releaseall
    end
}

script meganiumDefeat {
    setflag(FLAG_GALADRIA_GYM_MEGANIUM_MOVED)
    msgbox("I dream a lot...")
    waitmessage
    applymovement(Meganium, Galadria_Movement_Meg)
    waitmovement
    releaseall
    end
}

script BreloomTrainer {
    lock
    faceplayer
    goto_if_defeated(TRAINER_BRENDAN_PLACEHOLDER, BreloomTrainer_Defeated)
    msgbox("Brawly was too weak for me.")
    waitmessage
    trainerbattle_single(TRAINER_BRENDAN_PLACEHOLDER, BreloomIntro, BreloomDefeatText, breloomDefeat)
    releaseall
    end
}

script BreloomTrainer_Defeated {
    msgbox("I know Brawly went easy on me.")
    waitmessage
    releaseall
    end
}

script breloomDefeat {
    setflag(FLAG_GALADRIA_GYM_BRELOOM_MOVED)
    msgbox("I know Brawly went easy on me.")
    waitmessage
    applymovement(Breloom, Galadria_Movement_Bre)
    waitmovement
    releaseall
    end
}

text Leaf_no_mon {
    "A single blossom is beautiful,\n but a garden thrives in numbers…"
}
